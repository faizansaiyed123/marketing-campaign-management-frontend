# Local development: call the FastAPI backend directly.
VITE_API_URL=http://localhost:8000

# Vercel production: leave VITE_API_URL unset and set BACKEND_API_URL
# as a server-side Vercel environment variable to the deployed backend origin.
# Example value only: https://api.your-real-domain.example
# Never put backend secrets in VITE_* variables.
